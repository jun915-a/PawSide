<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this window theme only needs to be a borderless,
         edge-to-edge shell. -->
    <style name="Theme.Pawside" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/paw_charcoal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
